---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Kawalerka - wynajem krótko terminowy.

Informacje o obiekcie: \n
-Adres: Graniczna 11, Świętochłowice, Polska\n
-Kawalerka znajduje się w świętochłowicach (Lipiny) w nowowyremontowanej kamienicy na 2 piętrze z windą\n
-Wyposażony w aneks kuchenny z salonem, mały pokoik z łóżkiem i łazienke.\n
-Bezpłatne WiFi\n
-Obiekt monitorowany\n
\n
Informacje o okolicy:\n
-Bardzo blisko do: Katowice, Gliwice, Zabrze, Bytom i Chorzów\n
-Blisko sklepy\n
Cena: 200zł, do negocjacji.\n

<Layout title="Wynajem">
    <!-- 1. Header with Button -->
    <header class="fixed top-0 left-0 w-full bg-white shadow-md z-40 py-4 px-6 flex justify-between items-center">
        <h2 class="text-xl font-bold text-[#355C7D]">Agnik</h2>
        <button id="open-calendar" class="bg-[#355C7D] text-white px-6 py-2 rounded-full hover:bg-[#2a4a63] transition-colors">
            Sprawdź dostępność
        </button>
    </header>

    <!-- Adjust margin so content doesn't hide under header -->
    <div class="mt-24">
        <ContextAlert class="mb-4" />
        <h1 class="mb-10 text-4xl font-bold text-center">Wynajem Dobowy Agnik</h1>
        <Markdown content={explainer} class="text-lg mb-10" />
        
        <!-- ... Your existing Image Grid ... -->
        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
            <img src="/assets/inna-sofa.jpg" alt="Sofa" class="grid-img" />
            <!-- Add other images here -->
        </section>
    </div>

    <!-- 2. Calendar Modal -->
    <div id="calendar-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
            <div class="bg-[#355C7D] p-4 text-white flex justify-between items-center">
                <button id="prev-month" class="p-2 hover:bg-white/20 rounded">◀</button>
                <h3 id="month-label" class="font-bold text-lg uppercase tracking-wider">Miesiąc Rok</h3>
                <button id="next-month" class="p-2 hover:bg-white/20 rounded">▶</button>
            </div>
            
            <div class="p-4">
                <div class="grid grid-cols-7 gap-1 text-center font-bold text-gray-400 mb-2">
                    <div>Pn</div><div>Wt</div><div>Śr</div><div>Cz</div><div>Pt</div><div>So</div><div>Nd</div>
                </div>
                <div id="calendar-days" class="grid grid-cols-7 gap-1 text-center">
                    <!-- Days generated by JS -->
                </div>
                <div class="mt-6 flex gap-4 text-sm justify-center">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-100 border border-red-400 rounded"></span> Zajęte</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-green-100 border border-green-400 rounded"></span> Wolne</span>
                </div>
                <button id="close-calendar" class="mt-6 w-full py-2 border-2 border-[#355C7D] text-[#355C7D] font-bold rounded-lg hover:bg-[#355C7D] hover:text-white transition-all">
                    Zamknij
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Calendar & Data Logic -->
    <script>
        let currentMonth = new Date();
        const today = new Date();
        today.setHours(0,0,0,0);

        async function fetchBookedDates() {
            try {
                // Reading from public/availability.json
                const response = await fetch('/availability.json');
                const data = await response.json();
                return data.bookedDates;
            } catch (e) {
                console.error("Could not load availability", e);
                return [];
            }
        }

        async function renderCalendar() {
            const bookedDates = await fetchBookedDates();
            const daysContainer = document.getElementById('calendar-days');
            const monthLabel = document.getElementById('month-label');
            
            daysContainer.innerHTML = '';
            monthLabel.innerText = currentMonth.toLocaleString('pl-PL', { month: 'long', year: 'numeric' });

            const year = currentMonth.getFullYear();
            const month = currentMonth.getMonth();
            
            // Get first day of month and adjust to Monday start (European style)
            let firstDay = new Date(year, month, 1).getDay();
            firstDay = firstDay === 0 ? 6 : firstDay - 1; 

            const daysInMonth = new Date(year, month + 1, 0).getDate();

            // Padding for start of month
            for (let i = 0; i < firstDay; i++) {
                daysContainer.innerHTML += `<div></div>`;
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateObj = new Date(year, month, d);
                const dateStr = dateObj.toISOString().split('T')[0];
                const isPast = dateObj < today;
                const isBooked = bookedDates.includes(dateStr);

                let statusClass = "bg-green-50 text-green-700 border border-green-200";
                if (isPast) statusClass = "bg-gray-100 text-gray-400 cursor-not-allowed";
                else if (isBooked) statusClass = "bg-red-100 text-red-700 border border-red-200 line-through";

                daysContainer.innerHTML += `
                    <div class="py-3 rounded-md text-sm font-medium ${statusClass}">
                        ${d}
                    </div>
                `;
            }

            // Disable back button if viewing current month
            (document.getElementById('prev-month') as HTMLButtonElement).disabled = 
                month === today.getMonth() && year === today.getFullYear();
        }

        // Event Listeners
        document.getElementById('open-calendar').addEventListener('click', () => {
            document.getElementById('calendar-modal').classList.remove('hidden');
            renderCalendar();
        });

        document.getElementById('close-calendar').addEventListener('click', () => {
            document.getElementById('calendar-modal').classList.add('hidden');
        });

        document.getElementById('next-month').addEventListener('click', () => {
            currentMonth.setMonth(currentMonth.getMonth() + 1);
            renderCalendar();
        });

        document.getElementById('prev-month').addEventListener('click', () => {
            currentMonth.setMonth(currentMonth.getMonth() - 1);
            renderCalendar();
        });
    </script>

    <style>
        #prev-month:disabled { opacity: 0.3; cursor: not-allowed; }
        .grid-img {
            @apply rounded-lg shadow-lg hover:scale-105 transition-transform duration-300 cursor-pointer;
        }
    </style>
    
    <!-- ... Rest of your Footer and Lightbox code ... -->
</Layout>
