---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Kawalerka - wynajem krótko terminowy.

Informacje o obiekcie:
- Adres: Graniczna 11, Świętochłowice, Polska
- Kawalerka znajduje się w Świętochłowicach (Lipiny) w nowowyremontowanej kamienicy na 2 piętrze z windą
- Wyposażony w aneks kuchenny z salonem, mały pokoik z łóżkiem i łazienkę.
- Bezpłatne WiFi
- Obiekt monitorowany

Informacje o okolicy:
- Bardzo blisko do: Katowice, Gliwice, Zabrze, Bytom i Chorzów
- Blisko sklepy
Cena: 200zł, do negocjacji.
`;
---

<Layout title="Wynajem">
    <header class="fixed top-0 left-0 w-full bg-white shadow-md z-40 py-4 px-6 flex justify-between items-center">
        <h2 class="text-xl font-bold text-[#355C7D]">Agnik</h2>
        <button id="open-calendar" class="bg-[#355C7D] text-white px-6 py-2 rounded-full hover:bg-[#2a4a63] transition-colors">
            Sprawdź dostępność
        </button>
    </header>

    <div class="mt-24 px-4">
        <ContextAlert class="mb-4" />
        <h1 class="mb-10 text-4xl font-bold text-center">Wynajem Dobowy Agnik</h1>
        <Markdown content={explainer} class="text-lg mb-10" />

        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
            <img src="/assets/inna-sofa.jpg" alt="Sofa" class="grid-img" />
            <img src="/assets/kuchnia.jpg" alt="Kuchnia" class="grid-img" />
            <img src="/assets/laizenka.jpg" alt="Łazienka" class="grid-img" />
            <img src="/assets/prysznic.jpg" alt="Prysznic" class="grid-img" />
            <img src="/assets/sofa-lozko.jpg" alt="Łóżko" class="grid-img" />
            <img src="/assets/sofa-stolik.jpg" alt="Przestrzeń wspólna" class="grid-img" />
            <img src="/assets/stolik-telewizor.jpg" alt="Stolik z telewizorem" class="grid-img" />
            <img src="/assets/szafa.jpg" alt="Szafa z lustrem" class="grid-img" />
        </section>
    </div>

    <div id="calendar-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden text-gray-900">
            <div class="bg-[#355C7D] p-4 text-white flex justify-between items-center">
                <button id="prev-month" class="p-2">◀</button>
                <h3 id="month-label" class="font-bold uppercase"></h3>
                <button id="next-month" class="p-2">▶</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-7 gap-1 text-center font-bold text-gray-400 mb-2">
                    <div>Pn</div><div>Wt</div><div>Śr</div><div>Cz</div><div>Pt</div><div>So</div><div>Nd</div>
                </div>
                <div id="calendar-days" class="grid grid-cols-7 gap-1 text-center"></div>
                <button id="close-calendar" class="mt-6 w-full py-2 border-2 border-[#355C7D] text-[#355C7D] font-bold rounded-lg">Zamknij</button>
            </div>
        </div>
    </div>

    <footer class="bg-[#222] text-white p-6 mt-10 text-center">
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between gap-4">
            <p>📍 Graniczna 11, Świętochłowice</p>
            <p>📞 <a href="tel:516726657" class="text-yellow-400">516726657</a></p>
            <p>📧 wynajemka-kontakt@onet.pl</p>
        </div>
    </footer>

    <script is:inline>
        let currentMonth = new Date();
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        async function renderCalendar() {
            let bookedDates = [];
            try {
                const res = await fetch('/availability.json');
                const data = await res.json();
                bookedDates = data.bookedDates || [];
            } catch (e) { console.log("No availability file found"); }

            const daysContainer = document.getElementById('calendar-days');
            const monthLabel = document.getElementById('month-label');
            const prevBtn = document.getElementById('prev-month');
            
            if (!daysContainer || !monthLabel) return;

            daysContainer.innerHTML = '';
            monthLabel.innerText = currentMonth.toLocaleString('pl-PL', { month: 'long', year: 'numeric' });

            const year = currentMonth.getFullYear();
            const month = currentMonth.getMonth();
            let firstDay = new Date(year, month, 1).getDay();
            firstDay = firstDay === 0 ? 6 : firstDay - 1; 
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < firstDay; i++) {
                daysContainer.appendChild(document.createElement('div'));
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateObj = new Date(year, month, d);
                const dateStr = dateObj.toISOString().split('T')[0];
                const isPast = dateObj < today;
                const isBooked = bookedDates.includes(dateStr);

                const dayEl = document.createElement('div');
                dayEl.className = "py-3 rounded-md text-sm font-medium border ";
                dayEl.innerText = d;

                if (isPast) dayEl.className += "bg-gray-100 text-gray-400";
                else if (isBooked) dayEl.className += "bg-red-100 text-red-700 border-red-200 line-through";
                else dayEl.className += "bg-green-50 text-green-700 border-green-200";

                daysContainer.appendChild(dayEl);
            }

            if (prevBtn) {
                prevBtn.style.display = (month === today.getMonth() && year === today.getFullYear()) ? 'none' : 'block';
            }
        }

        document.getElementById('open-calendar')?.addEventListener('click', () => {
            document.getElementById('calendar-modal')?.classList.remove('hidden');
            renderCalendar();
        });

        document.getElementById('close-calendar')?.addEventListener('click', () => {
            document.getElementById('calendar-modal')?.classList.add('hidden');
        });

        document.getElementById('next-month')?.addEventListener('click', () => {
            currentMonth.setMonth(currentMonth.getMonth() + 1);
            renderCalendar();
        });

        document.getElementById('prev-month')?.addEventListener('click', () => {
            currentMonth.setMonth(currentMonth.getMonth() - 1);
            renderCalendar();
        });
    </script>

    <style>
        .grid-img {
            @apply rounded-lg shadow-lg hover:scale-105 transition-transform duration-300 cursor-pointer;
        }
    </style>
</Layout>
