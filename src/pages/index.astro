---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Kawalerka - wynajem krótko terminowy.

Informacje o obiekcie: \n
-Adres: Graniczna 11, Świętochłowice, Polska\n
-Kawalerka znajduje się w świętochłowicach (Lipiny) w nowowyremontowanej kamienicy na 2 piętrze z windą\n
-Wyposażony w aneks kuchenny z salonem, mały pokoik z łóżkiem i łazienke.\n
-Bezpłatne WiFi\n
-Obiekt monitorowany\n
\n
Informacje o okolicy:\n
-Bardzo blisko do: Katowice, Gliwice, Zabrze, Bytom i Chorzów\n
-Blisko sklepy\n
Cena: 200zł, do negocjacji.\n

`;
---

<Layout title="Wynajem">
    <ContextAlert class="mb-4" />
    <h1 class="mb-10">Wynajem Dobowy Agnik</h1>
    <Markdown content={explainer} class="text-lg mb-10" />
    <!-- 📷 3x3 Picture Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <img src="/assets/inna-sofa.jpg" alt="Sofa" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/kuchnia.jpg" alt="Kuchnia" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/laizenka.jpg" alt="Łazienka" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/prysznic.jpg" alt="Prysznic" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/sofa-lozko.jpg" alt="Łóżko" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/sofa-stolik.jpg" alt="Przestrzeń wspólna" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/stolik-telewizor.jpg" alt="Stolik z telewizorem" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        <img src="/assets/szafa.jpg" alt="Szafa z lustrem" class="grid-img rounded-lg shadow-lg hover:scale-105 transition-transform duration-300" />
        
    </section>
    

<footer class="footer bg-[#355C7D] bg-grid-pattern">
  <div class="footer-container py-6 text-center">
    <div class="footer-contact">
      <p>📍 Graniczna 11, Świętochłowice, Polska</p>
      <p>📞 <a href="tel:516726657">516726657</a></p>
      <p>📧 <a href="wynajemka-kontakt@onet.pl">wynajemka-kontakt@onet.pl</a></p>
      <p>Języki: Polski, English</p>
    </div>
    
  </div>
</footer>

<!-- 🔍 Fullscreen Image Viewer -->
    <div id="lightbox" class="hidden fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50">
      <img id="lightbox-img" class="max-w-full max-h-full rounded-lg" src="" alt="" />
      <button id="close-btn" class="absolute top-4 right-6 text-white text-3xl cursor-pointer">✖️</button>
      <button id="prev-btn" class="absolute left-6 text-white text-5xl cursor-pointer">◀️</button>
      <button id="next-btn" class="absolute right-6 text-white text-5xl cursor-pointer">▶️</button>
    </div>

    <style>
      .grid-img {
        @apply rounded-lg shadow-lg hover:scale-105 transition-transform duration-300 cursor-pointer;
      }
    </style>

    <script>
      const images = Array.from(document.querySelectorAll('.grid-img'));
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      let currentIndex = 0;

      function showImage(index) {
        currentIndex = index;
        lightboxImg.src = images[index].src;
        lightbox.classList.remove('hidden');
      }

      images.forEach((img, index) => {
        img.addEventListener('click', () => showImage(index));
      });

      document.getElementById('close-btn').addEventListener('click', () => {
        lightbox.classList.add('hidden');
      });

      document.getElementById('prev-btn').addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        showImage(currentIndex);
      });

      document.getElementById('next-btn').addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % images.length;
        showImage(currentIndex);
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') lightbox.classList.add('hidden');
        if (e.key === 'ArrowLeft') document.getElementById('prev-btn').click();
        if (e.key === 'ArrowRight') document.getElementById('next-btn').click();
      });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) lightbox.classList.add('hidden');
      });
    </script>

<style>
  .footer {
    background: #222;
    color: white;
    padding: 20px;
    text-align: center;
  }

  .footer-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-contact a {
    color: #f8c01c;
    text-decoration: none;
  }

  .footer-social a {
    margin: 0 10px;
    font-size: 20px;
  }

  @media (min-width: 600px) {
    .footer-container {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>

</Layout>
