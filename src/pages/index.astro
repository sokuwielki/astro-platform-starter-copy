---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';
import RegulaminContent from '../pages/regulamin.astro';
import UmowaContent from '../pages/umowa.astro';

const explainer = `
Kawalerka - wynajem krótko terminowy.

Informacje o obiekcie:
- Adres: Graniczna 11, Świętochłowice, Polska
- Kawalerka znajduje się w Świętochłowicach (Lipiny) w nowowyremontowanej kamienicy na 2 piętrze z windą
- Wyposażony w aneks kuchenny z salonem, mały pokoik z łóżkiem i łazienkę.
- Bezpłatne WiFi
- Obiekt monitorowany

Informacje o okolicy:
- Bardzo blisko do: Katowice, Gliwice, Zabrze, Bytom i Chorzów
- Blisko sklepy
Cena: 200zł, do negocjacji.
`;
---

<Layout title="Wynajem">
    <!-- Header stays the same as previous response -->
    <header class="fixed top-0 left-0 w-full bg-white shadow-md z-40 py-4 px-6 flex flex-wrap justify-between items-center gap-4">
        <h2 class="text-xl font-bold text-[#355C7D] order-1">Agnik</h2>
        <div class="flex gap-4 order-3 sm:order-2 w-full sm:w-auto justify-center">
            <button id="open-regulamin" class="nav-link">Regulamin</button>
            <button id="open-umowa" class="nav-link">Umowa</button>
        </div>
        <button id="open-calendar" class="bg-[#355C7D] text-white px-5 py-2 rounded-full order-2 sm:order-3">
            Sprawdź dostępność
        </button>
    </header>

    <div class="mt-24 px-4">
        <ContextAlert class="mb-4" />
        <h1 class="mb-10 text-4xl font-bold text-center">Wynajem Dobowy Agnik</h1>
        <Markdown content={explainer} class="text-lg mb-10" />

        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
            <img src="/assets/inna-sofa.jpg" alt="Sofa" class="grid-img" />
            <img src="/assets/kuchnia.jpg" alt="Kuchnia" class="grid-img" />
            <img src="/assets/laizenka.jpg" alt="Łazienka" class="grid-img" />
            <img src="/assets/prysznic.jpg" alt="Prysznic" class="grid-img" />
            <img src="/assets/sofa-lozko.jpg" alt="Łóżko" class="grid-img" />
            <img src="/assets/sofa-stolik.jpg" alt="Przestrzeń wspólna" class="grid-img" />
            <img src="/assets/stolik-telewizor.jpg" alt="Stolik z telewizorem" class="grid-img" />
            <img src="/assets/szafa.jpg" alt="Szafa z lustrem" class="grid-img" />
        </section>
    </div>

    <!-- Modal for Documents -->
    <div id="doc-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[80vh] overflow-hidden flex flex-col relative">
            <button id="close-doc" class="absolute top-4 right-4 text-2xl text-gray-400 hover:text-black">✖</button>
            <div class="p-8 overflow-y-auto">
                <h2 id="doc-title" class="text-2xl font-bold mb-4 text-[#355C7D]"></h2>
                <div id="doc-content" class="text-gray-700 leading-relaxed">
                    <!-- Component HTML will be injected here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden Storage for Astro Component HTML -->
    <div id="source-regulamin" class="hidden">
        <RegulaminContent />
    </div>
    <div id="source-umowa" class="hidden">
        <UmowaContent />
    </div>

    <script is:inline>
        // Updated Document Modal Logic
        function openDoc(type) {
            const title = type === 'regulamin' ? 'Regulamin' : 'Umowa';
            const sourceId = `source-${type}`;
            const content = document.getElementById(sourceId).innerHTML;

            document.getElementById('doc-title').innerText = title;
            document.getElementById('doc-content').innerHTML = content;
            document.getElementById('doc-modal').classList.remove('hidden');
        }

        document.getElementById('open-regulamin')?.addEventListener('click', () => openDoc('regulamin'));
        document.getElementById('open-umowa')?.addEventListener('click', () => openDoc('umowa'));
        
        document.getElementById('close-doc')?.addEventListener('click', () => {
            document.getElementById('doc-modal').classList.add('hidden');
        });

        // Close on clicking backdrop
        document.getElementById('doc-modal')?.addEventListener('click', (e) => {
            if (e.target.id === 'doc-modal') e.target.classList.add('hidden');
        });

       // --- CALENDAR LOGIC ---
        async function renderCalendar() {
            let bookedDates = [];
            try {
                const res = await fetch('/availability.json');
                const data = await res.json();
                bookedDates = data.bookedDates || [];
            } catch (e) { console.log("Availability file missing"); }

            const daysContainer = document.getElementById('calendar-days');
            const monthLabel = document.getElementById('month-label');
            const prevBtn = document.getElementById('prev-month');
            
            if (!daysContainer || !monthLabel) return;

            daysContainer.innerHTML = '';
            monthLabel.innerText = currentMonth.toLocaleString('pl-PL', { month: 'long', year: 'numeric' });

            const year = currentMonth.getFullYear();
            const month = currentMonth.getMonth();
            let firstDay = new Date(year, month, 1).getDay();
            firstDay = firstDay === 0 ? 6 : firstDay - 1; 
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < firstDay; i++) {
                daysContainer.appendChild(document.createElement('div'));
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateObj = new Date(year, month, d);
                const dateStr = dateObj.toISOString().split('T')[0];
                const isPast = dateObj < today;
                const isBooked = bookedDates.includes(dateStr);

                const dayEl = document.createElement('div');
                dayEl.className = "py-3 rounded-md text-sm font-medium border ";
                dayEl.innerText = d;

                if (isPast) dayEl.className += "bg-gray-100 text-gray-400";
                else if (isBooked) dayEl.className += "bg-red-100 text-red-700 border-red-200 line-through";
                else dayEl.className += "bg-green-50 text-green-700 border-green-200 cursor-pointer";

                daysContainer.appendChild(dayEl);
            }

            if (prevBtn) {
                prevBtn.style.visibility = (month === today.getMonth() && year === today.getFullYear()) ? 'hidden' : 'visible';
            }
        }
    </script>

    <style>
        .nav-link {
            @apply text-gray-600 hover:text-[#355C7D] font-medium border-b-2 border-transparent hover:border-[#355C7D] transition-all cursor-pointer;
        }
        .grid-img {
            @apply rounded-lg shadow-lg hover:scale-105 transition-transform duration-300 cursor-pointer;
        }
    </style>
</Layout>
